# =====================================================
# EcoRuta Wanka — Archivos ignorados por Git
# Stack: Node.js + Express + Prisma (backend/) · Next.js (frontend/)
# =====================================================

# ---------- Dependencias ----------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------- Variables de entorno y credenciales ----------
# Nunca se versionan; se documentan en los archivos .env.example
.env
.env.*
!.env.example
*.pem
*.key
credentials/

# ---------- Next.js (frontend) ----------
.next/
out/
next-env.d.ts
*.tsbuildinfo
# Archivos de instrucciones para asistentes de código que genera `next dev`
frontend/AGENTS.md
frontend/CLAUDE.md

# ---------- Builds y despliegue ----------
build/
dist/
.vercel/

# ---------- Pruebas y cobertura ----------
coverage/
*.lcov
.nyc_output/

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Temporales ----------
*.tmp
*.tmp.*
tmp/
temp/

# ---------- Editor y sistema operativo ----------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
