# =====================================================
# EcoRuta Wanka — Variables de entorno del backend (ejemplo)
# Copia este archivo como "backend/.env" (NO lo subas a GitHub).
# =====================================================

# Neon (PostgreSQL). Panel de Neon > Connect.
# Con pooling (host con "-pooler"): la usa la aplicación.
DATABASE_URL="postgresql://usuario:contraseña@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Directa (sin "-pooler"): la usa Prisma para las migraciones.
DATABASE_URL_UNPOOLED="postgresql://usuario:contraseña@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# API key de OpenRouteService (https://account.heigit.org, plan gratuito, sin tarjeta).
# Sin ella, la generación de rutas responde 503.
ORS_API_KEY=

# Puerto de la API y URL del frontend permitida por CORS
PORT=4000
FRONTEND_URL=http://localhost:3000

# Factores de tráfico por franja horaria (implementación futura). Por defecto: false
# TRAFICO_HABILITADO=false

# Margen de seguridad (minutos) antes del cierre de cada ventana al calcular la salida óptima. Por defecto: 15
# MARGEN_VENTANA_MIN=15

# Almacén de salida y regreso de los vehículos (por defecto: Plaza de la Constitución, Huancayo)
# ALMACEN_NOMBRE=Almacén WankaLogística
# ALMACEN_LATITUD=-12.0681
# ALMACEN_LONGITUD=-75.2104
