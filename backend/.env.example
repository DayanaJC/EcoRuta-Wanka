# =====================================================
# EcoRuta Wanka — Variables de entorno del backend (ejemplo)
# Copia este archivo como "backend/.env" (NO lo subas a GitHub).
# =====================================================

# Cadena de conexión de Neon (PostgreSQL). Panel de Neon > Connect.
DATABASE_URL=postgresql://usuario:contraseña@host.neon.tech/neondb?sslmode=require

# API key de OpenRouteService (https://account.heigit.org, plan gratuito, sin tarjeta).
# Sin ella, la generación de rutas responde 503.
ORS_API_KEY=

# Puerto de la API y URL del frontend permitida por CORS
PORT=4000
FRONTEND_URL=http://localhost:3000

# Almacén de salida y regreso de los vehículos (por defecto: Plaza de la Constitución, Huancayo)
# ALMACEN_NOMBRE=Almacén WankaLogística
# ALMACEN_LATITUD=-12.0681
# ALMACEN_LONGITUD=-75.2104
