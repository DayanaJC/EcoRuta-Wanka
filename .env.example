# Ruta hacia el archivo de credenciales (service account) de Firebase.
# El archivo JSON NO debe subirse al repositorio.
# Ejemplo: credentials/firebase-service-account.json
# o:       C:\seguro\firebase-service-account.json
FIREBASE_CREDENTIALS_PATH=